# Managed by enroll.yml.
[Unit]
Description=DARZ Agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/darz-agent \
  -coordinators {{ darz_agent_coordinators }} \
  -ca /etc/darz/ca.crt \
  -state-dir /var/lib/darz-agent \
  -enroll-token-file /etc/darz/enroll-token
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
