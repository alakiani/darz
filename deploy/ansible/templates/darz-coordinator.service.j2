# Managed by coordinator.yml.
[Unit]
Description=DARZ Coordinator
After=network-online.target
Wants=network-online.target

[Service]
User=darz
Group=darz
ExecStart=/usr/local/bin/darz-coordinator \
  -db /var/lib/darz/darz.db \
  -ca-dir /etc/darz/ca \
{% if darz_tls_cert %}
  -admin-tls-cert /etc/darz/secrets/tls.crt -admin-tls-key /etc/darz/secrets/tls.key \
{% endif %}
  -prometheus-tls-dir /etc/darz/prometheus \
  -monitor-from {{ darz_monitor_from }} \
{% if darz_arvan_api_key %}
  -arvan-api-key-file /etc/darz/secrets/arvan-api-key \
{% endif %}
{% if darz_telegram_token %}
  -telegram-token-file /etc/darz/secrets/telegram-token -telegram-chat {{ darz_telegram_chat }} \
{% endif %}
{% if darz_backup_s3_endpoint %}
  -backup-s3-endpoint {{ darz_backup_s3_endpoint }} -backup-s3-region {{ darz_backup_s3_region }} \
  -backup-s3-bucket {{ darz_backup_s3_bucket }} -backup-s3-key-file /etc/darz/secrets/backup-s3-key \
{% endif %}
  -backup-age-recipient {{ darz_backup_age_recipient }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
