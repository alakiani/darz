# Managed by enroll.yml.
[Unit]
Description=WAYS Agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/ways-agent \
  -coordinators {{ ways_agent_coordinators }} \
  -ca /etc/ways/ca.crt \
  -state-dir /var/lib/ways-agent \
  -enroll-token-file /etc/ways/enroll-token
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
