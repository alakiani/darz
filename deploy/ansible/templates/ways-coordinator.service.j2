# Managed by coordinator.yml.
[Unit]
Description=WAYS Coordinator
After=network-online.target
Wants=network-online.target

[Service]
User=ways
Group=ways
ExecStart=/usr/local/bin/ways-coordinator \
  -db /var/lib/ways/ways.db \
  -ca-dir /etc/ways/ca \
{% if ways_tls_cert %}
  -admin-tls-cert /etc/ways/secrets/tls.crt -admin-tls-key /etc/ways/secrets/tls.key \
{% endif %}
  -prometheus-tls-dir /etc/ways/prometheus \
  -monitor-from {{ ways_monitor_from }} \
{% if ways_arvan_api_key %}
  -arvan-api-key-file /etc/ways/secrets/arvan-api-key \
{% endif %}
{% if ways_telegram_token %}
  -telegram-token-file /etc/ways/secrets/telegram-token -telegram-chat {{ ways_telegram_chat }} \
{% endif %}
{% if ways_backup_s3_endpoint %}
  -backup-s3-endpoint {{ ways_backup_s3_endpoint }} -backup-s3-region {{ ways_backup_s3_region }} \
  -backup-s3-bucket {{ ways_backup_s3_bucket }} -backup-s3-key-file /etc/ways/secrets/backup-s3-key \
{% endif %}
  -backup-age-recipient {{ ways_backup_age_recipient }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
