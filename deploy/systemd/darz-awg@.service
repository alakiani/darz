# One amneziawg-go daemon per AmneziaWG instance (ADR 0007). The Agent starts
# and stops these; tunnels outlive Agent restarts.
[Unit]
Description=DARZ AmneziaWG instance %i
After=network-online.target

[Service]
ExecStart=/usr/local/lib/darz/amneziawg-go -f %i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
