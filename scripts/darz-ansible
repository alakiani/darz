#!/usr/bin/env bash
# darz-ansible PLAYBOOK [ansible-playbook args] runs a deployment playbook
# against the fleet in ~/.darz: it loads fleet.env (from
# scripts/provision-fleet.sh) and uses inventory.yml beside it.
# DARZ_RELEASE picks the release in ~/.darz/releases; it defaults to the
# newest one there (scripts/fetch-release.sh downloads one).
#
#   scripts/darz-ansible coordinator.yml
#   scripts/darz-ansible enroll.yml -l ir-1
set -euo pipefail
export DARZ_HOME="${DARZ_HOME:-$HOME/.darz}"
[[ $# -ge 1 ]] || { sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 2; }
[[ -f "$DARZ_HOME/fleet.env" ]] || { echo "no $DARZ_HOME/fleet.env: run scripts/provision-fleet.sh first" >&2; exit 1; }
set -a
# shellcheck source=/dev/null
. "$DARZ_HOME/fleet.env"
set +a
if [[ -z "${DARZ_RELEASE:-}" ]]; then
  DARZ_RELEASE=$(ls -t "$DARZ_HOME/releases" 2>/dev/null | head -n1 || true)
  [[ -n "$DARZ_RELEASE" ]] || { echo "no release in $DARZ_HOME/releases: run scripts/fetch-release.sh VERSION" >&2; exit 1; }
fi
export DARZ_RELEASE
echo "release $DARZ_RELEASE" >&2
playbook="$1"; shift
cd "$(dirname "$0")/../deploy/ansible"
exec ansible-playbook -i "${DARZ_INVENTORY:-$DARZ_HOME/inventory.yml}" "$playbook" "$@"
